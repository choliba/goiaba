{
  "name": "goiaba",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "arquiteto": "bun agents/arquiteto.ts",
    "chat": "bun agents/chat-agente.ts",
    "ollama:codex": "bun agents/ollama.codex.ts",
    "ollama:claude": "bun agents/ollama.claude.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src test agents scripts goiaba.config.ts",
