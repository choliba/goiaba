  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@elastic/ecs-pino-format": "^1.5.0",
    "pino": "^10.4.0"
