{
  "name": "goiaba",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "ollama:codex": "bun agents/ollama.codex.ts",
    "ollama": "bun agents/ollama.ts",
    "tui": "bun agents/tui.ts",
    "rounds": "bun rounds/run.ts",
    "rounds:web": "bun run --cwd rounds/web dev",
    "rounds:build": "bun run --cwd rounds/web build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p rounds/web",
    "lint": "oxlint --type-aware src test agents scripts guides rounds goiaba.config.ts",
    "lint:fix": "oxlint --type-aware --fix src test agents scripts guides rounds goiaba.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "approvals": "bun src/cli/approvals.ts",
    "issue": "bun scripts/issue.ts",
    "clear": "bun scripts/clear.ts",
    "generate-guides": "bun scripts/generate-guides.ts",
    "test": "bun test test/"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@elastic/ecs-pino-format": "^1.5.0",
    "ollama": "^0.6.4",
    "pino": "^10.4.0"
  }
}
