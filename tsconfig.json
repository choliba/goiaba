{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "types": ["node", "bun"],
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "bin/**/*.ts",
    "agents/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "guides/**/*.ts",
    "rounds/*.ts",
    "rounds/definitions/**/*.ts",
    "goiaba.config.ts"
  ]
}
